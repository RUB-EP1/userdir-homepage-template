#!/usr/bin/env -S uv run --script
# /// script
# dependencies = [
#   "rich",
#   "typer",
# ]
# ///
import os
import shutil
import subprocess
from pathlib import Path
from typing import Annotated

import rich
import typer
from rich.progress import (
    BarColumn,
    MofNCompleteColumn,
    Progress,
    TextColumn,
    TimeRemainingColumn,
)

THIS_DIR = Path(__file__).resolve().parent
SOURCE_DIR = THIS_DIR / "docs" / "_build" / "html"
PROTECTED_DIRS = {"_images", "site_libs"}


def update_www(
    *,
    rebuild: Annotated[
        bool, typer.Option(help="Run `poe doc` before uploading.")
    ] = True,
    upload: Annotated[bool, typer.Option(help="Copy build files to EP1 WWW.")] = True,
) -> None:
    """Update the EP1 homepage on EP1 WWW.

    The homepage is served from the WWW root, but sub-projects (e.g. project-name)
    live in subdirectories of that same root. Those subpages are backed up before
    the root is replaced and restored afterwards.
    """
    if rebuild:
        rich.print("[bold blue]Building documentation...")
        if SOURCE_DIR.exists():
            git = _get_executable("git")
            subprocess.run([git, "clean", "-xdf", SOURCE_DIR], check=True)  # noqa: S603
        poe = _get_executable("poe")
        subprocess.run([poe, "doc"], check=True)  # noqa: S603
        rich.print("[green]Build complete")

    if upload:
        www_dir = Path(f"/home/tau/{os.getenv('USER')}/WWW")
        if not www_dir.exists():
            rich.print("[red]Could not copy build files to EP1 WWW")
            rich.print(f"[red]--> {www_dir} not available")
            raise typer.Exit(code=1)

        subpages = _find_subpages(www_dir)
        backup_dir = www_dir.with_name(f"{www_dir.name}-backup")
        if subpages:
            rich.print("[blue]Backing up subpages...")
            shutil.rmtree(backup_dir, ignore_errors=True)
            backup_dir.mkdir()
            for subpage in subpages:
                rich.print(f"  - {subpage.name}")
                shutil.move(str(subpage), str(backup_dir / subpage.name))

        shutil.rmtree(www_dir, ignore_errors=True)
        total = sum(1 for f in SOURCE_DIR.rglob("*") if f.is_file())
        with Progress(
            TextColumn("[progress.description]{task.description}"),
            BarColumn(),
            MofNCompleteColumn(),
            TimeRemainingColumn(elapsed_when_finished=True),
        ) as progress:
            task = progress.add_task("[blue]Copying build files", total=total)

            def _copy(src: str, dst: str, **kwargs: object) -> str:
                shutil.copy2(src, dst, **kwargs)  # ty:ignore[no-matching-overload]
                progress.advance(task)
                return dst

            shutil.copytree(SOURCE_DIR, www_dir, copy_function=_copy)

        if subpages:
            rich.print("[blue]Restoring subpages...")
            for subpage in subpages:
                rich.print(f"  - {subpage.name}")
                shutil.move(str(backup_dir / subpage.name), str(www_dir / subpage.name))
            shutil.rmtree(backup_dir, ignore_errors=True)

        rich.print("[blue]Setting permissions...")
        chmod = _get_executable("chmod")
        find = _get_executable("find")
        subprocess.run([chmod, "-R", "g-wrx,o-rw", www_dir], check=True)  # noqa: S603
        subprocess.run(  # noqa: S603
            [find, www_dir, "-type", "d", "-exec", "chmod", "o+x", "{}", "+"],
            check=True,
        )
        subprocess.run(  # noqa: S603
            [find, www_dir, "-type", "f", "-exec", "chmod", "o+r", "{}", "+"],
            check=True,
        )
        rich.print(
            f"[green]Documentation on https://ep1.rub.de/~{os.getenv('USER')} has been updated"
        )
    else:
        rich.print("[yellow]Rerun with --upload to copy files to EP1 WWW.")


def _find_subpages(www_dir: Path) -> list[Path]:
    return [
        path
        for path in sorted(www_dir.iterdir())
        if path.is_dir() and path.name not in PROTECTED_DIRS
    ]


def _get_executable(name: str, /) -> Path:
    path = shutil.which(name)
    if path is None:
        msg = f"{name} executable not found in PATH"
        raise FileNotFoundError(msg)
    return Path(path)


def main() -> None:
    typer.run(update_www)


if __name__ == "__main__":
    raise SystemExit(main())
